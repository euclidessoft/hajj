{% extends "layout.html.twig" %}
{% block title %} {{ 'Pèlerins sans versement'|trans }} - Hajjalbayt {% endblock %}
{% block pelerin %} class="nav-item dropright active" {% endblock %}
{% block facture %} onload="window.print()" onafterprint="window.history.back()" {% endblock %}
{% block body %}

    {% if app.user.agence.licence == 1 %}
        <div class="container-fluid mt-4 mb-5 fond-7">
            <h3 class="mt-4 mb-5 text-bold">
                <i class="fa fa-users mr-2"></i>
                {{ 'Pèlerins sans versement'|trans }}
            </h3>
            <table class="table table-success-light table-bordered table-hover table-striped">
                <thead>
                <tr>
                    <th class="text-center">{{ 'Numéro'|trans }}</th>
                    <th class="text-center">{{ 'Photo'|trans }}</th>
                    <th>{{ 'Prénom'|trans }}</th>
                    <th>{{ 'Nom'|trans }}</th>
                    <th class="text-center">{{ 'Date de naissance'|trans }}</th>
                    <th>{{ 'Lieu de naissance'|trans }}</th>
                    <th class="passeport">{{ 'Nº Passeport'|trans }}</th>
                    <th class="phone">{{ 'Téléphone'|trans }}</th>
                    <th class="text-center">{{ 'Date d\'inscription'|trans }}</th>
                    <th>{{ 'Package'|trans }}</th>
                    <th class="text-center">{{ 'Situation'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% set montantotal = 0 %}
                {% if pelerins is not empty %}
                    {% for pelerin in pelerins %}
                        {% if pelerin.sexe == 'Masculin' %}
                            <tr class="bg-man">
                        {% else %}
                            <tr class="bg-woman">
                        {% endif %}
                        <td data-label="{{ 'Numéro dossier'|trans }}" class="text-center">
                                {{ pelerin.numdossier }}
                        </td>
                        <td data-label="{{ 'Photo'|trans }}">
                            {% if pelerin.image is not empty %}
                                    <img src="{{ asset('images/'~ pelerin.image.url) }}" alt="{{ pelerin.image.alt }}"
                                         class="rounded-circle">
                            {% else %}
                                    {% if pelerin.sexe == 'Feminin' %}
                                        <img src="{{ asset('images/avatar-femme.jpg') }}" alt="Photo pèlerin"
                                             class="rounded-circle">
                                    {% else %}
                                        <img src="{{ asset('images/avatar.jpg') }}" alt="Photo pèlerin"
                                             class="rounded-circle">
                                    {% endif %}
                            {% endif %}
                        </td>
                        <td data-label="{{ 'Prénom'|trans }}">
                                {{ pelerin.prenom }}
                        </td>
                        <td data-label="{{ 'Nom'|trans }}">
                                {{ pelerin.nom }}
                        </td>
                        <td data-label="{{ 'Date de naissance'|trans }}" class="text-center">
                                {% if pelerin.datenaiss is empty %}

                                {% else %}
                                    {{ pelerin.datenaiss|date('d/m/Y') }}
                                {% endif %}
                        </td>
                        <td data-label="{{ 'Lieu de naissance'|trans }}">
                                {{ pelerin.lieunaiss }}
                        </td>
                        <td data-label="{{ 'Nº Passeport'|trans }}" class="passeport">
                                {{ pelerin.numpassport }}
                        </td>
                        <td data-label="{{ 'Téléphone'|trans }}" class="phone">
                                {{ pelerin.phone }}
                        </td>
                        <td data-label="{{ 'Date d\'inscription'|trans }}" class="text-center">
                            {{ pelerin.date|date('d/m/Y') }}
                            <br>
                            {{ pelerin.date|date('H:i:s') }}
                        </td>
                        <td data-label="{{ 'Package'|trans }}">
                                {{ pelerin.pack.designation }}
                        </td>
                        <td data-label="{{ 'Situation'|trans }}" class="KO montant">
                            {{ (-1 * pelerin.situation)|number_format(0, '' , ' ') }}
                        </td>
                        {% set montantotal = montantotal + pelerin.situation %}
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td data-label="colspan" colspan="10">
                            {{ 'Aucun pèlerin'|trans }}
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
            {% if is_granted('ROLE_CHEF') %}
                <h4 class="mt-3 mb-3 text-dark">
                    {{ 'Montant à recouvrer'|trans }} :
                    <span class="text-danger text-bold montant">
            {{ (montantotal)|number_format(0, '' , ' ') }} F CFA
        </span>
                </h4>
            {% endif %}
        </div>
    {% else %}
        {{ include('licence/licence-page.html.twig') }}
    {% endif %}

{% endblock %}
